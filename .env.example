# Required. OpenRouter key used for the Jev decision model (Decisions API).
OPENROUTER_API_KEY=
# Model id sent to OpenRouter. Default pins the version the trade rule was tuned on.
JEV_MODEL=typesafe/jev-1.13

# Optional. Kalshi API key for the live WebSocket tape (move detector, price-at-publish, priced-in guard).
# Both must be set or the tape is disabled; public Kalshi market data works without them.
KALSHI_API_KEY_ID=
# Path to the PEM file, OR the full PEM text, OR the bare base64 body of a PKCS#8 key (RSA or Ed25519).
KALSHI_PRIVATE_KEY_PATH=

# Required for the SEC EDGAR 8-K poller (SEC fair-access policy). Format: "Name email@example.com".
# Leave empty to run without EDGAR.
SEC_USER_AGENT=

# Optional. Extra Host header values the dashboard API accepts, comma separated. Localhost is always allowed.
FASTLANE_ALLOWED_HOSTS=

# Paper sizing (no real money).
PAPER_BANKROLL_USD=10000
PAPER_MAX_TRADE_PCT=0.02
PAPER_DAILY_LOSS_HALT_PCT=0.05

# Cost filter (real rule and shadow): skip markets where spread and fees would eat the gains.
MAX_SPREAD_CENTS=3
COST_TO_ROOM_MAX=0.25

# Shadow mode: a separate paper book of what a looser rule would have traded. The real rule is not affected.
SHADOW_ENABLED=true
SHADOW_SIGNAL_THRESHOLD=0.60
SHADOW_DECISIVE_MIN=0.0

# Rate limits and spending caps. Also set a credit limit on the OpenRouter key itself.
JEV_MAX_CALLS_PER_HOUR=600
JEV_MAX_USD_PER_DAY=5
API_RATE_LIMIT_PER_MIN=120
API_RATE_LIMIT_BURST=60

# Real trading on Kalshi. OFF unless set to 1, and every engine start is on paper anyway: you also have to flip the
# dashboard switch and type the confirmation. Needs a Kalshi API key with trading permission (above).
LIVE_TRADING_ENABLED=0
LIVE_MAX_ORDER_USD=5
LIVE_MAX_DAILY_USD=25
LIVE_MAX_ORDERS_PER_HOUR=6

# Backups (python3 -m fastlane.backup --verify runs the restore drill). Empty BACKUP_DIR = fastlane/results/backups.
BACKUP_EVERY_HOURS=6
BACKUP_DIR=
BACKUP_KEEP=28

# Error reports. Crash reports (scrubbed: no keys, no headlines) go to the maintainer unless FASTLANE_TELEMETRY=0.
# Set FASTLANE_SENTRY_DSN to send them to your own Sentry project instead.
FASTLANE_TELEMETRY=1
FASTLANE_SENTRY_DSN=
