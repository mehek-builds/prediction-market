# Required. OpenRouter key used for the Jev decision model (Decisions API).
OPENROUTER_API_KEY=
# Model id sent to OpenRouter. Default pins the version the trade rule was tuned on.
JEV_MODEL=typesafe/jev-1.13

# Optional. Kalshi API key for the live WebSocket tape (move detector, price-at-publish, priced-in guard).
# Both must be set or the tape is disabled; public Kalshi market data works without them.
KALSHI_API_KEY_ID=
# Path to the PEM file, OR the full PEM text, OR the bare base64 body of a PKCS#8 key (RSA or Ed25519).
KALSHI_PRIVATE_KEY_PATH=

# Required for the SEC EDGAR 8-K poller (SEC fair-access policy). Format: "Name email@example.com".
# Leave empty to run without EDGAR.
SEC_USER_AGENT=

# Optional. Extra Host header values the dashboard API accepts, comma separated. Localhost is always allowed.
# Never expose the API port beyond this machine while LIVE_TRADING_ENABLED=1: the Host check only protects browsers.
# Anyone who can reach the port can arm real trading within the LIVE_MAX_* caps.
FASTLANE_ALLOWED_HOSTS=

# Paper sizing (no real money).
PAPER_BANKROLL_USD=10000
PAPER_MAX_TRADE_PCT=0.02
PAPER_DAILY_LOSS_HALT_PCT=0.05

# Cost filter (real rule and shadow): skip markets where spread and fees would eat the gains.
MAX_SPREAD_CENTS=3
COST_TO_ROOM_MAX=0.25

# Shadow mode: a separate paper book of what a looser rule would have traded. The real rule is not affected.
# (the dashboard toggle, stored in the ledger, overrides SHADOW_ENABLED)
SHADOW_ENABLED=true
SHADOW_SIGNAL_THRESHOLD=0.60
SHADOW_DECISIVE_MIN=0.0

# Live quotes in selection: after Jev answers, wait at most this long for the order books fetched while Jev was
# thinking, and rank the candidate markets on those live prices instead of the cached ones. 0 = use only books that
# have already landed.
LIVE_QUOTE_WAIT_MS=150

# Entry style per paper book: take (cross the spread now) or post (rest a bid inside the spread; fills only if the
# market comes to us). ENTRY_STYLE, if set, replaces all three defaults; ENTRY_STYLE_* then override one book each.
# The LIVE book stays take: it mirrors the immediate-or-cancel order real trading sends (forced take while armed).
ENTRY_STYLE=
ENTRY_STYLE_LIVE=take
ENTRY_STYLE_SHADOW=post
ENTRY_STYLE_STARTER=post
# Resting paper orders: expire after this many seconds, snapshot cadence per order (min 1), and the most that may rest.
POST_MAX_WAIT_S=300
POST_POLL_S=2
POST_MAX_WORKING=20

# Starter book: a small paper book on a stricter-than-shadow rule (strength >= STARTER_SIGNAL_THRESHOLD, no decisive
# requirement), fixed size per trade. Env only. Never a real order, never counted in the real book.
STARTER_ENABLED=true
STARTER_SIGNAL_THRESHOLD=0.90
STARTER_DECISIVE_MIN=0.0
STARTER_SIZE_USD=20

# Scheduled data releases (CPI, jobs report, FOMC statement): read the number from the official source and buy the
# Kalshi strikes it settles. Dates come from fastlane/release_calendar.json; an empty calendar never arms.
# BLS_API_KEY is the free BLS v2 registration key (api.bls.gov); without it CPI and jobs releases are disabled.
RELEASES_ENABLED=true
BLS_API_KEY=
RELEASE_POLL_START_S=2
RELEASE_POLL_EVERY_S=1.5
RELEASE_POLL_MAX_S=90
RELEASE_BLS_DAILY_BUDGET=400
# CPI: stay this many percentage points away from a rounding boundary (x.x5) of the one-decimal figure Kalshi settles on.
RELEASE_MARGIN_CPI_PP=0.02
# Payrolls: stay this many thousand jobs away from every strike.
RELEASE_MARGIN_PAYROLLS_K=10
RELEASE_MAX_MARKETS_PER_SERIES=1

# FOMC on Polymarket: Kalshi closes its Fed ladders before 14:00 ET; Polymarket's "Fed Decision in <Month>?" brackets stay
# open. Paper only (there is no Polymarket order client). POLY_FOMC_MAX_NO: dead brackets bought NO after the YES (0 = none).
POLY_FOMC_ENABLED=true
POLY_FOMC_MAX_NO=1

# Optional. xAI key for the X poller (one Grok x_search call per poll, about $0.018 to $0.055 each). Off when empty.
XAI_API_KEY=
# Up to 10 X handles without @, comma separated. Empty = the default group below.
XAI_X_HANDLES=DeItaone,FirstSquawk,LiveSquawk,zerohedge,unusual_whales,Polymarket,Breaking911,KobeissiLetter,WhiteHouse,truthsocial
XAI_POLL_SECONDS=60
# Hard cap per UTC day, persisted in the ledger (a restart does not reset it). Polling stops for the day when reached.
XAI_DAILY_BUDGET_USD=25
# Only poll inside this window (US market hours by default).
XAI_WINDOW_DAYS=Mon,Tue,Wed,Thu,Fri
XAI_WINDOW_HOURS=09:00-16:30
XAI_WINDOW_TZ=America/New_York

# Bluesky newsroom accounts over the public Jetstream firehose (keyless). Own top-level posts only.
BSKY_ENABLED=true
BSKY_HANDLES=reuters.com,bloomberg.com,apnews.com,financialtimes.com,wsj.com,nytimes.com,cnbc.com,politico.com,nbcnews.com,washingtonpost.com

# Cost filter: entries below this price are long shots (no realistic exit).
MIN_ENTRY_PRICE=0.03
# Move detector deny pattern (regex, case-insensitive, matched against Kalshi market title and ticker). Empty = default.
MOVE_DENY_RE=

# Rate limits and spending caps. Also set a credit limit on the OpenRouter key itself.
JEV_MAX_CALLS_PER_HOUR=600
JEV_MAX_USD_PER_DAY=5
API_RATE_LIMIT_PER_MIN=120
API_RATE_LIMIT_BURST=60

# Real trading on Kalshi. OFF unless set to 1, and every engine start is on paper anyway: you also have to flip the
# dashboard switch and type the confirmation. Needs a Kalshi API key with trading permission (above).
LIVE_TRADING_ENABLED=0
LIVE_MAX_ORDER_USD=5
LIVE_MAX_DAILY_USD=25
LIVE_MAX_ORDERS_PER_HOUR=6
# Real NO orders stay off (NO signals remain paper trades) until you verify NO-side behaviour with 1-contract orders on
# Kalshi's demo environment. Then set 1.
# The check is: python3 tools/demo_no_order_check.py --ticker <demo ticker> --fill --yes (see the README).
LIVE_ALLOW_NO_SIDE=0
# Kalshi host. Default production. Demo (needs a demo API key): https://demo-api.kalshi.co, which keeps its data in
# fastlane/results-demo/. Anything else is refused.
# KALSHI_BASE_URL=https://api.elections.kalshi.com
# DANGEROUS, leave 0: lets clients other than this machine read the control token and arm real trading.
LIVE_ALLOW_REMOTE_CONTROL=0

# Backups (python3 -m fastlane.backup --verify runs the restore drill). Empty BACKUP_DIR = fastlane/results/backups.
BACKUP_EVERY_HOURS=6
BACKUP_DIR=
BACKUP_KEEP=28

# Error reports are OFF: nothing is sent unless you opt in. Set FASTLANE_SENTRY_DSN to send scrubbed crash reports to
# your own Sentry project, or FASTLANE_TELEMETRY=1 to share them with the maintainer (only if the build has a DSN).
FASTLANE_TELEMETRY=0
FASTLANE_SENTRY_DSN=
